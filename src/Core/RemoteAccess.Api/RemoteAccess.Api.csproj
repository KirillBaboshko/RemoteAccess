<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <Configurations>Debug;Release;Core</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAccess.Application\RemoteAccess.Application.csproj" />
    <ProjectReference Include="..\RemoteAccess.Infrastructure\RemoteAccess.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contracts\RemoteAccess.Contracts.Core\RemoteAccess.Contracts.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.80.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.4.1" />
    <PackageReference Include="Swashbuckle.AspNetCore">
      <Version>10.1.7</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Grpc\Devices\GetDeviceAccessRequestValidator.cs">
      <DependentUpon>DeviceAccessGrpcService.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
