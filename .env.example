# Copy to .env and set a random secret, for example 32 random bytes as hex.
# The same value is used as Ice:SharedSecret in Signaling.
TURN_SHARED_SECRET=
TURN_REALM=remoteaccess.local

# Use 127.0.0.1 here only when clients run on this PC.
# For other clients, set the reachable host/domain of the Docker machine.
TURN_PUBLIC_HOST=127.0.0.1
# Set this PC's LAN IPv4 for development, or its public IPv4 for Internet access.
# A loopback address cannot be used for relay traffic with this configuration.
TURN_EXTERNAL_IP=
